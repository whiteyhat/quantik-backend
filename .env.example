PORT=3001
POLYMARKET_CLI=/root/.local/bin/polymarket
FRONTEND_URL=https://quantik.vercel.app
FRED_API_KEY=            # FRED (Federal Reserve Economic Data) — macro alt data
NEWS_API_KEY=            # NewsAPI.org — news headlines for Aura sentiment (legacy fallback)
METACULUS_API_KEY=       # Metaculus — cross-market prediction signals for Oracle
BLS_API_KEY=             # BLS (Bureau of Labor Statistics) — jobs/macro alt data
# Aura sentiment feed
ALGOLIA_HN_API_KEY=      # Algolia HN search-only key (hn.algolia.com)
GUARDIAN_API_KEY=        # The Guardian Open Platform API key
NYT_API_KEY=             # NYT Article Search API key
CRYPTOPANIC_API_KEY=     # CryptoPanic API token — crypto news sentiment
PORTFOLIO_USDC_FALLBACK=1000  # Fallback portfolio size when CLI/live balance unavailable
# Clerk authentication
CLERK_PUBLISHABLE_KEY=       # Clerk publishable key (pk_live_... for production)
CLERK_SECRET_KEY=            # Clerk secret key (sk_live_... for production)
# REQUIRED in production when using a custom Clerk domain (e.g. clerk.quantik.fun).
# Get from: Clerk Dashboard → API Keys → "Show JWT public key" → copy PEM (-----BEGIN PUBLIC KEY-----)
# Without this, the backend fetches JWKS from api.clerk.com using CLERK_SECRET_KEY — if that key
# belongs to a different Clerk instance than the one signing tokens, you'll get 401 errors (kid mismatch).
CLERK_JWT_KEY=               # PEM public key — enables local, networkless JWT verification
# PostgreSQL (optional — enables multi-tenant features; falls back to SQLite if not set)
DATABASE_URL=                # e.g. postgresql://user:pass@host/quantik?sslmode=require
# Redis (optional — enables BullMQ job queues + rate limiting; falls back to setInterval if not set)
REDIS_URL=                   # e.g. rediss://default:token@us1-xxx.upstash.io:6379
# Encryption (optional — enables AES-256-GCM encryption of API keys at rest)
ENCRYPTION_KEY=              # 64-char hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Backend self-URL (used by ERC-8004 services and market scanner)
BACKEND_URL=                 # e.g. https://api.quantik.fun
# CoinDesk market data for Aura sentiment
COINDESK_API_KEY=            # CoinDesk Data API key
# Google Gemini LLM (powers Sigma, Oracle, Clause, Lucifer, Relay)
GEMINI_API_KEY=              # Google AI Studio API key
# Trading mode
PAPER_TRADING=true           # set to "false" for live CLOB execution
DUAL_MARKET=false            # set to "true" for simultaneous Polymarket + Kraken
# ERC-8004 On-Chain Agent Identity (Sepolia)
ERC8004_PRIVATE_KEY=         # raw hex — local dev only
ERC8004_ENCRYPTED_KEY=       # AES-256-GCM encrypted — production (format: iv:ciphertext:authTag)
ERC8004_RPC_URL=             # e.g. https://sepolia.infura.io/v3/YOUR_KEY
ERC8004_IDENTITY_REGISTRY=   # deployed IdentityRegistry contract address
ERC8004_REPUTATION_REGISTRY= # deployed ReputationRegistry contract address
ERC8004_VALIDATION_REGISTRY= # deployed ValidationRegistry contract address
# Kraken CLI integration
KRAKEN_CLI=                  # path to kraken binary (defaults to "kraken" on PATH)
KRAKEN_TRADING_MODE=paper    # "paper" or "live"
CHAIN_MODE=polymarket        # "polymarket" or "kraken"

# ── Access control ────────────────────────────────────────────
# Clerk user IDs (user_...) allowed to change platform-wide state: panic mode,
# paper/live mode, Kraken credentials, risk limits. Comma-separated.
# Empty = nobody (fails closed).
ADMIN_USER_IDS=
# Secret passed to Telegram setWebhook(secret_token); callbacks are rejected without it.
TELEGRAM_WEBHOOK_SECRET=
# Sentry integration client secret; the Sentry webhook is rejected without it.
SENTRY_WEBHOOK_SECRET=
