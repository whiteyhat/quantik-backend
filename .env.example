PORT=3001
POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_CLI=/root/.local/bin/polymarket
FRONTEND_URL=https://quantik.vercel.app
FRED_API_KEY=            # FRED (Federal Reserve Economic Data) — macro alt data
NEWS_API_KEY=            # NewsAPI.org — news headlines for Aura sentiment (legacy fallback)
METACULUS_API_KEY=       # Metaculus — cross-market prediction signals for Oracle
BLS_API_KEY=             # BLS (Bureau of Labor Statistics) — jobs/macro alt data
# Aura sentiment feed
ALGOLIA_HN_API_KEY=      # Algolia HN search-only key (hn.algolia.com)
GUARDIAN_API_KEY=        # The Guardian Open Platform API key
NYT_API_KEY=             # NYT Article Search API key
CRYPTOPANIC_API_KEY=     # CryptoPanic API token — crypto news sentiment
PORTFOLIO_USDC_FALLBACK=1000  # Fallback portfolio size when CLI/live balance unavailable
