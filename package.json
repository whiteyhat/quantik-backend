{
  "name": "quantik-backend",
  "version": "1.0.0",
  "description": "Quantik Trading Terminal — backend API wrapping Polymarket CLI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --testPathPatterns=tests/ --passWithNoTests",
    "seed": "tsx src/db/seed.ts",
    "seed:releases": "tsx src/db/seed-releases.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.0.1",
    "@electric-sql/pglite": "^0.3.15",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.6",
    "@scure/bip39": "^2.0.1",
    "@sentry/node": "^10.40.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/spl-token-metadata": "^0.1.6",
    "@tetherto/wdk": "^1.0.0-beta.6",
    "@tetherto/wdk-wallet-evm": "^1.0.0-beta.8",
    "@types/pg": "^8.18.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.3",
    "better-sqlite3": "^11.7.0",
    "bn.js": "^5.2.3",
    "bullmq": "^5.70.4",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "express": "^4.21.0",
    "form-data": "^4.0.5",
    "ioredis": "^5.9.3",
    "pg": "^8.20.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3",
    "tweetnacl": "^1.0.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs"
          }
        }
      ],
      "^.+\\.js$": ["ts-jest", { "tsconfig": { "module": "commonjs", "allowJs": true } }]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@scure|@noble|@solana/spl-token|@solana/spl-token-metadata|@solana/buffer-layout-utils|@solana/spl-token-group|@meteora-ag/dynamic-bonding-curve-sdk|@tetherto|@electric-sql/pglite|formidable|zod|superstruct|valibot|uncrypto|axios)/)"
    ],
    "testTimeout": 60000
  }
}
