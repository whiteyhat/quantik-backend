{
  "name": "quantik-backend",
  "version": "1.0.0",
  "description": "Quantik Trading Terminal — backend API wrapping Polymarket CLI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --testPathPatterns=tests/ --passWithNoTests",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.0.1",
    "@electric-sql/pglite": "^0.3.15",
    "@sentry/node": "^10.40.0",
    "@tetherto/wdk": "^1.0.0-beta.6",
    "@tetherto/wdk-wallet-evm": "^1.0.0-beta.8",
    "@types/pg": "^8.18.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.3",
    "better-sqlite3": "^11.7.0",
    "bullmq": "^5.70.4",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "ioredis": "^5.9.3",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs"
          }
        }
      ]
    },
    "testTimeout": 60000
  }
}
